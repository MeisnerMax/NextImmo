# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/
.design_sources/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
node_modules/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Golden-test diff artifacts (regenerated on every failing run)
test/**/failures/

# Environment files. Never commit real values -- only NEXIMMO_ENV,
# NEXIMMO_DATA_BACKEND, SUPABASE_URL and SUPABASE_PUBLISHABLE_KEY may ever reach
# a client, and they arrive through --dart-define, not through a file. Server
# credentials (service role key, secret key, DB password, access token) must
# never be written to the working tree at all.
.env
.env.*
!.env.example
!**/.env.example

# Supabase CLI local state
supabase/.temp/
supabase/.branches/

# Next.js build output (marketing/)
.next/
out/
.vercel/
